# ---------------------------------------------------------------------------
# SportyClub - variables de entorno de ejemplo
# Copia este archivo como .env y ajusta los valores.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=local
DEBUG=true

# Dominio base usado para resolver el tenant por subdominio.
# En local se recomienda lvh.me (resuelve a 127.0.0.1) o niproxy.
# Ejemplos: club1.lvh.me  /  club1.sportyclub.app
BASE_DOMAIN=lvh.me

# Origen(es) permitidos para CORS (panel de administracion), separados por coma.
CORS_ORIGINS=http://lvh.me:3000,http://localhost:3000

# URL base del panel para enlaces de invitacion / reset. En local: http + puerto 3000.
PANEL_SCHEME=http
PANEL_PORT=3000

# --- Base de datos ---
POSTGRES_USER=sportyclub
POSTGRES_PASSWORD=sportyclub
POSTGRES_DB=sportyclub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Rol de aplicacion (sin privilegios, sujeto a RLS). Se crea en la migracion inicial.
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user

# --- Seguridad / JWT ---
# Genera un secreto real con: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_ALGORITHM=HS256

# --- Bootstrap del superadmin de plataforma (seed) ---
PLATFORM_ADMIN_EMAIL=admin@sportyclub.app
PLATFORM_ADMIN_PASSWORD=change-me-please

# --- Panel (Next.js) ---
# URL interna del backend que usa el panel (el mismo proceso Next) para hablar con la API.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BASE_DOMAIN=lvh.me
